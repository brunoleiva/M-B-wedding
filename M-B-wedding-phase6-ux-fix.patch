diff --git a/src/services/wedding/appearance.ts b/src/services/wedding/appearance.ts
index dcb5eb5..1d7227b 100644
--- a/src/services/wedding/appearance.ts
+++ b/src/services/wedding/appearance.ts
@@ -17,6 +17,24 @@ export const defaultColors = {
   brand_color: "#65704d", accent_color: "#a87655",
 };
 export type ColorKey = keyof typeof defaultColors;
+export type ColorPalette = typeof defaultColors;
+export const defaultColumn = (key: ColorKey) => `default_${key}` as const;
+
+export async function getSavedDefaultColors(weddingId?: string): Promise<ColorPalette> {
+  const fallback = {...defaultColors};
+  if (!weddingId) return fallback;
+  const db = await createSupabaseServerClient();
+  if (!db) return fallback;
+  const {data} = await db.from("wedding_appearance").select("default_background_color,default_surface_color,default_foreground_color,default_brand_color,default_accent_color")
+    .eq("wedding_id", weddingId).maybeSingle();
+  if (!data) return fallback;
+  for (const key of Object.keys(fallback) as ColorKey[]) {
+    const value = data[defaultColumn(key)];
+    if (typeof value === "string" && /^#[0-9a-fA-F]{6}$/.test(value)) fallback[key] = value;
+  }
+  return fallback;
+}
+
 export type Appearance = { colors: typeof defaultColors; visible: Record<SectionKey, boolean> };
 export const defaultVisibility = (): Record<SectionKey, boolean> =>
   Object.fromEntries(sections.map(s=>[s.key,true])) as Record<SectionKey,boolean>;
diff --git a/supabase/migrations/202610130006_appearance_defaults.sql b/supabase/migrations/202610130006_appearance_defaults.sql
new file mode 100644
index 0000000..e8f7280
--- /dev/null
+++ b/supabase/migrations/202610130006_appearance_defaults.sql
@@ -0,0 +1,7 @@
+-- A separate palette snapshot: the currently active colors remain independent.
+alter table public.wedding_appearance
+  add column if not exists default_background_color text not null default '#f8f4ed' check (default_background_color ~ '^#[0-9a-fA-F]{6}$'),
+  add column if not exists default_surface_color text not null default '#fffdf9' check (default_surface_color ~ '^#[0-9a-fA-F]{6}$'),
+  add column if not exists default_foreground_color text not null default '#261f1a' check (default_foreground_color ~ '^#[0-9a-fA-F]{6}$'),
+  add column if not exists default_brand_color text not null default '#65704d' check (default_brand_color ~ '^#[0-9a-fA-F]{6}$'),
+  add column if not exists default_accent_color text not null default '#a87655' check (default_accent_color ~ '^#[0-9a-fA-F]{6}$');
