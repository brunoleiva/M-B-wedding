@@ -0,0 +1,26 @@
+import { createSupabaseServerClient } from "@/lib/supabase/server";
+
+export async function getGuestInformation(weddingId: string, admin = false) {
+ const db = await createSupabaseServerClient();
+ if (!db) return { people: [], faqs: [], hotels: [], info: null };
+ const [people, faqs, hotels, info] = await Promise.all([
+  db.from("special_people").select("id,name,role_label,category,description,image_path,sort_order,is_published").eq("wedding_id",weddingId).order("sort_order"),
+  db.from("faqs").select("id,question,answer,sort_order,is_active").eq("wedding_id",weddingId).order("sort_order"),
+  db.from("recommended_hotels").select("id,name,address,notes,website_url,sort_order,is_published").eq("wedding_id",weddingId).order("sort_order"),
+  db.from("guest_information").select("dress_title,dress_description,colors_to_avoid,transport_text,parking_text,is_published").eq("wedding_id",weddingId).maybeSingle(),
+ ]);
+ return {
+  people: (people.data ?? []).filter(x=>admin || x.is_published).map(x=>({...x,image_url:x.image_path ? db.storage.from("wedding-media").getPublicUrl(x.image_path).data.publicUrl : null})),
+  faqs: (faqs.data ?? []).filter(x=>admin || x.is_active),
+  hotels: (hotels.data ?? []).filter(x=>admin || x.is_published),
+  info: (admin || info.data?.is_published) ? info.data : null,
+ };
+}
+
+export async function getPublicGuestInformation() {
+ const db = await createSupabaseServerClient();
+ if(!db) return {people:[],faqs:[],hotels:[],info:null};
+ const { data: wedding } = await db.from("weddings").select("id").eq("is_published",true).order("created_at").limit(1).maybeSingle();
+ if(!wedding) return {people:[],faqs:[],hotels:[],info:null};
+ return getGuestInformation(wedding.id);
+}
diff --git a/supabase/migrations/202610130004_guest_information.sql b/supabase/migrations/202610130004_guest_information.sql
new file mode 100644
index 0000000..fa9507e
--- /dev/null
+++ b/supabase/migrations/202610130004_guest_information.sql
@@ -0,0 +1,29 @@
+-- Informações opcionais aos convidados. Manter o conteúdo privado até publicação.
+create table public.guest_information (
+ wedding_id uuid primary key references public.weddings(id) on delete cascade,
+ dress_title text, dress_description text, colors_to_avoid text,
+ transport_text text, parking_text text,
+ is_published boolean not null default false,
+ created_at timestamptz not null default now(), updated_at timestamptz not null default now()
+);
+create trigger guest_information_updated_at before update on public.guest_information for each row execute function public.set_updated_at();
+alter table public.guest_information enable row level security;
+create policy "published guest information" on public.guest_information for select to anon, authenticated
+ using (is_published and exists (select 1 from public.weddings w where w.id=wedding_id and w.is_published));
+create policy "admins manage guest information" on public.guest_information for all to authenticated
+ using (public.is_wedding_admin(wedding_id)) with check (public.is_wedding_admin(wedding_id));
+
+create table public.recommended_hotels (
+ id uuid primary key default gen_random_uuid(),
+ wedding_id uuid not null references public.weddings(id) on delete cascade,
+ name text not null, address text, notes text, website_url text,
+ sort_order integer not null default 0, is_published boolean not null default false,
+ created_at timestamptz not null default now(), updated_at timestamptz not null default now()
+);
+create index recommended_hotels_order on public.recommended_hotels(wedding_id,sort_order);
+create trigger recommended_hotels_updated_at before update on public.recommended_hotels for each row execute function public.set_updated_at();
+alter table public.recommended_hotels enable row level security;
+create policy "published hotels" on public.recommended_hotels for select to anon, authenticated
+ using (is_published and exists (select 1 from public.weddings w where w.id=wedding_id and w.is_published));
+create policy "admins manage hotels" on public.recommended_hotels for all to authenticated
+ using (public.is_wedding_admin(wedding_id)) with check (public.is_wedding_admin(wedding_id));
