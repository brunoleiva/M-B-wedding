# Public Supabase configuration (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Keep outside the browser. Reserved for trusted server jobs only.
SUPABASE_SERVICE_ROLE_KEY=

# Public canonical URL used by metadata/sitemap. Configure in Vercel production.
# Do not include a trailing slash.
# VERCEL_ENV is provided automatically by Vercel (preview/production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
