+import { formatWeddingDate, formatWeddingTime, type Venue, type ScheduleItem } from "@/services/wedding/event-details";
+
+export function WeddingDetails({ venues, schedule, timezone, compact=false }: {venues:Venue[];schedule:ScheduleItem[];timezone:string;compact?:boolean}) {
+  if (!venues.length && !schedule.length) return null;
+  return <div className="space-y-12">
+    {venues.length>0 && <div className={compact ? "grid gap-4 md:grid-cols-2" : "grid gap-6 md:grid-cols-2"}>{venues.map(venue=><article key={venue.id} className="card-soft p-7 sm:p-9"><p className="eyebrow">{venue.kind === "both" ? "Cerimônia e recepção" : venue.kind === "ceremony" ? "Cerimônia" : "Recepção"}</p><h3 className="font-editorial mt-3 text-4xl">{venue.name}</h3>{venue.starts_at && <p className="mt-4 text-sm font-semibold">{formatWeddingDate(venue.starts_at,timezone)} · {formatWeddingTime(venue.starts_at,timezone)}</p>}{venue.description && <p className="mt-4 leading-7 text-muted">{venue.description}</p>}<p className="mt-4 text-sm font-semibold">{venue.address}</p><div className="mt-5 flex flex-wrap gap-3">{venue.google_maps_url && <a href={venue.google_maps_url} target="_blank" rel="noopener noreferrer" className="rounded-full border border-line px-4 py-2 text-sm underline">Google Maps</a>}{venue.waze_url && <a href={venue.waze_url} target="_blank" rel="noopener noreferrer" className="rounded-full border border-line px-4 py-2 text-sm underline">Waze</a>}</div></article>)}</div>}
+    {schedule.length>0 && <section aria-label="Cronograma do casamento"><h2 className="font-editorial mb-7 text-center text-4xl">Programação do dia</h2><div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{schedule.map(item=><div key={item.id} className="rounded-2xl border border-line bg-surface p-6"><p className="font-editorial text-3xl text-brand-strong">{formatWeddingTime(item.starts_at,timezone)}</p><h3 className="mt-2 font-semibold">{item.title}</h3>{item.description && <p className="mt-2 text-sm leading-6 text-muted">{item.description}</p>}</div>)}</div></section>}
+  </div>;
+}
diff --git a/src/services/wedding/event-details.ts b/src/services/wedding/event-details.ts
new file mode 100644
index 0000000..813a02a
--- /dev/null
+++ b/src/services/wedding/event-details.ts
@@ -0,0 +1,34 @@
+import { createSupabaseServerClient } from "@/lib/supabase/server";
+
+export type Venue = {
+  id: string; kind: "ceremony" | "reception" | "both"; name: string; address: string;
+  description: string | null; starts_at: string | null; google_maps_url: string | null;
+  waze_url: string | null; is_published: boolean;
+};
+export type ScheduleItem = { id: string; starts_at: string; title: string; description: string | null; sort_order: number; is_public: boolean };
+
+export async function getEventDetails(weddingId: string, publishedOnly: boolean) {
+  const supabase = await createSupabaseServerClient();
+  if (!supabase) return { venues: [] as Venue[], schedule: [] as ScheduleItem[] };
+  let v = supabase.from("venues").select("id,kind,name,address,description,starts_at,google_maps_url,waze_url,is_published").eq("wedding_id", weddingId).order("created_at");
+  let s = supabase.from("schedule_events").select("id,starts_at,title,description,sort_order,is_public").eq("wedding_id", weddingId).order("starts_at").order("sort_order");
+  if (publishedOnly) { v = v.eq("is_published", true); s = s.eq("is_public", true); }
+  const [vr, sr] = await Promise.all([v, s]);
+  if (vr.error || sr.error) { console.error("Failed to load wedding details", vr.error?.code, sr.error?.code); }
+  return { venues: (vr.data ?? []) as Venue[], schedule: (sr.data ?? []) as ScheduleItem[] };
+}
+
+export async function getPublishedEventDetails() {
+  const supabase = await createSupabaseServerClient();
+  if (!supabase) return { venues: [] as Venue[], schedule: [] as ScheduleItem[], timezone: "America/Sao_Paulo" };
+  const { data: wedding } = await supabase.from("weddings").select("id,timezone").eq("is_published", true).order("created_at").limit(1).maybeSingle();
+  if (!wedding) return { venues: [] as Venue[], schedule: [] as ScheduleItem[], timezone: "America/Sao_Paulo" };
+  return { ...await getEventDetails(wedding.id, true), timezone: wedding.timezone as string };
+}
+
+export function formatWeddingTime(value: string, timezone: string) {
+  return new Intl.DateTimeFormat("pt-BR", { hour: "2-digit", minute: "2-digit", timeZone: timezone }).format(new Date(value));
+}
+export function formatWeddingDate(value: string, timezone: string) {
+  return new Intl.DateTimeFormat("pt-BR", { dateStyle: "full", timeZone: timezone }).format(new Date(value));
+}
